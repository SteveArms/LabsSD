# ============================================================
# Variables de entorno - Laboratorio 08
# Sistema Nacional de Bancos Cooperativos
# ============================================================

# --- Credenciales compartidas ---
DB_USER=admin
DB_PASSWORD=admin123

# --- Bases de datos por nodo ---
DB_NAME_AREQUIPA=banco_arequipa
DB_NAME_CUSCO=banco_cusco
DB_NAME_TRUJILLO=banco_trujillo

# --- Puertos expuestos en el host ---
PORT_AREQUIPA=5433
PORT_CUSCO=5434
PORT_TRUJILLO=5435

# --- Host (siempre localhost cuando se accede desde el host) ---
DB_HOST=localhost

# --- Monto de transferencia (en soles) ---
MONTO_TRANSFERENCIA=25000
